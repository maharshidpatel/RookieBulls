# .env.example — Environment Variable Template
#
# This file is committed to Git as documentation.
# It shows every variable the application needs to run.
# It contains NO real secrets — only placeholder values.
#
# Setup instructions:
#   1. Copy this file: cp .env.example .env  (Mac/Linux)
#                      Copy-Item .env.example .env  (Windows)
#   2. Replace placeholder values with real ones
#   3. Never commit the .env file — it is in .gitignore

# ─── Server ───────────────────────────────────────────────
# PORT: the network port your Express server listens on
# NODE_ENV: controls app behavior — use 'development' locally,
#           'production' on the live server
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
# Full MongoDB connection string.
# Format: mongodb://USERNAME:PASSWORD@HOST:PORT/DBNAME?authSource=admin
# - USERNAME/PASSWORD: set in docker-compose.yml under MONGO_INITDB_ROOT_*
# - HOST: localhost for local dev, server IP or hostname in production
# - PORT: 27017 is MongoDB's default port
# - DBNAME: the database that stores Rookie Bulls data
# - authSource=admin: MongoDB verifies credentials against the admin database
MONGO_URI=mongodb://root:example@localhost:27017/stocksim?authSource=admin

# ─── JWT (JSON Web Tokens) ────────────────────────────────
# Tokens are used to authenticate users after login.
# ACCESS token: short-lived, sent with every API request
# REFRESH token: long-lived, used to get a new access token
#
# SECRETS: random strings used to sign tokens cryptographically
#   - If someone knows your secret they can forge tokens
#   - Use long random strings in production
#   - Never reuse the same secret for access and refresh
#
# EXPIRY: how long before the token stops being valid
#   - 15m = 15 minutes (access token — short for security)
#   - 7d  = 7 days     (refresh token — longer for convenience)
JWT_ACCESS_SECRET=changeme_access
JWT_REFRESH_SECRET=changeme_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────────
# The URL of the frontend application.
# Express will only accept API requests coming from this origin.
# Locally this is the Vite dev server address.
# In production this becomes your real domain: https://rookiebulls.com
CLIENT_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────
# MARKET DATA PROVIDER
# ─────────────────────────────────────────────────────────────────
# Finnhub is the external service that supplies real stock prices.
# This key authenticates your server when it calls the Finnhub API.
# Every request to Finnhub must include this key as a query param.
# Without it, Finnhub returns a 401 and no price data is returned.
#
# Free tier limit: 60 requests per minute.
# Never expose this key to the frontend — all Finnhub calls are
# made server-side only, inside market/service.js.
# Never commit .env to git — this key is a secret.
FINNHUB_API_KEY=your_key_here

# ─────────────────────────────────────────────────────────────────
# MARKET HOURS BYPASS (development only)
# ─────────────────────────────────────────────────────────────────
# The trade engine blocks buy and sell actions when the NYSE is
# closed (weekends, before 9:30am EST, after 4:00pm EST, holidays).
# That check is enforced in trade/service.js via market/service.js.
#
# During development you need to test trades at any hour of the day.
# Setting this to true disables the market hours check entirely.
# market/service.js reads this flag — if true, isMarketOpen()
# returns true unconditionally without calling Finnhub.
#
# NEVER set this to true in production.
# A closed market that accepts trades is a broken simulation.
BYPASS_MARKET_HOURS=false